{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiji-tech",
  // No Worker code: Astro builds every page ahead of time, and Workers'
  // static assets serve dist/, with 404.html for paths it does not have.
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // The site is chiji.tech alone; its workers.dev address would only show
  // the same pages twice.
  "routes": [{ "pattern": "chiji.tech", "custom_domain": true }],
  "workers_dev": false,
  // Branches other than main are uploaded as Worker Previews by Workers
  // Builds (`wrangler preview`), seen at <branch>-chiji-tech.chiji.workers.dev.
  "preview_urls": true,
  "previews": {}
}
