---
import { Image } from "astro:assets";
import BackLink from "@/components/back-link.astro";
import Card from "@/components/card.astro";
import Page from "@/components/page.astro";
import Section from "@/components/section.astro";
import TextLink from "@/components/text-link.astro";
import type { App } from "@/data/apps";
import { CONTACT_EMAIL } from "@/data/contact";

interface Props {
  app: App;
  lead: string;
  store: {
    badge: { alt: string; src: string; width: number };
    href: string;
    label: string;
  };
}

const { app, lead, store } = Astro.props;
---

<Page
  description={`${app.name}のサポート情報とプライバシーポリシーを掲載しています。`}
  title={`${app.name} | CHIJI TECH`}
>
  <nav class="mb-12 flex justify-end"><BackLink /></nav>

  <header class="flex flex-col items-center py-10 text-center sm:py-14">
    <div class="relative">
      <Image
        alt={app.name}
        class="rounded-3xl shadow-sm ring-1 ring-zinc-200 dark:ring-zinc-800"
        densities={[1, 2]}
        height={104}
        priority
        src={app.icon}
        width={104}
      />
      <div
        class="absolute -inset-2 -z-10 rounded-3xl bg-zinc-200 opacity-50 blur-lg dark:bg-zinc-800"
      ></div>
    </div>

    <p class="mt-8 text-sm text-zinc-500 dark:text-zinc-400">CHIJI TECH</p>
    <h1
      class="mt-2 font-semibold text-3xl text-zinc-900 tracking-tight dark:text-zinc-100"
    >
      {app.name}
    </h1>
    <p
      class="mt-5 max-w-md text-pretty text-sm text-zinc-600 leading-relaxed dark:text-zinc-400"
    >
      {lead}
    </p>
    <div class="mt-7 flex max-w-lg flex-wrap justify-center gap-2">
      {app.badges.map((badge) => (
          <span class="rounded-md border border-zinc-200 bg-white px-2.5 py-1 font-mono text-xs text-zinc-500 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
            {badge}
          </span>
        ))}
    </div>
    <a
      aria-label={store.label}
      class="mt-8 inline-flex transition-opacity hover:opacity-80"
      href={store.href}
      rel="noopener noreferrer"
      target="_blank"
    >
      <img
        alt={store.badge.alt}
        height="40"
        src={store.badge.src}
        width={store.badge.width}
      >
    </a>
  </header>

  <Section title={`${app.name} サポート`}>
    <Card
      class="space-y-4 text-sm text-zinc-600 leading-relaxed dark:text-zinc-400"
    >
      <p>ご質問・不具合報告・ご要望は下記までご連絡ください。</p>
      <p>
        メール:{" "}
        <TextLink href={`mailto:${CONTACT_EMAIL}`} text={CONTACT_EMAIL} />
      </p>
    </Card>
  </Section>

  <Section title="プライバシーポリシー">
    <Card
      class="space-y-4 text-sm text-zinc-600 leading-relaxed dark:text-zinc-400"
    >
      <slot />
      <p>
        お問い合わせ:{" "}
        <TextLink href={`mailto:${CONTACT_EMAIL}`} text={CONTACT_EMAIL} />
      </p>
    </Card>
  </Section>
</Page>
