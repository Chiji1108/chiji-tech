---
import { Font } from "astro:assets";
import "@/styles/global.css";

interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;

// Shared links need whole URLs, not paths. The route, not Astro.url: a build
// names the file there (/paylog.html), which is not the page's address.
const url = new URL(Astro.routePattern, Astro.site);
const image = new URL("/og.png", Astro.site);
---

<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>{title}</title>
    <meta content={description} name="description">
    <link href={url} rel="canonical">
    <link href="/favicon.png" rel="icon" type="image/png">
    <link href="/apple-touch-icon.png" rel="apple-touch-icon">
    <meta content="website" property="og:type">
    <meta content="CHIJI TECH" property="og:site_name">
    <meta content="ja_JP" property="og:locale">
    <meta content={title} property="og:title">
    <meta content={description} property="og:description">
    <meta content={url} property="og:url">
    <meta content={image} property="og:image">
    <meta content="1200" property="og:image:width">
    <meta content="630" property="og:image:height">
    <meta content="summary_large_image" name="twitter:card">
    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
