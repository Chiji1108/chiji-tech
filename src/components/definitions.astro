---
interface Props {
  items: { href?: string; term: string; value: string }[];
}

const { items } = Astro.props;
---

<dl class="grid gap-3 text-sm">
  {items.map((item) => (
      <div class="grid grid-cols-1 gap-1 sm:grid-cols-3 sm:gap-4">
        <dt class="text-zinc-500 dark:text-zinc-400">{item.term}</dt>
        <dd class="text-zinc-900 sm:col-span-2 dark:text-zinc-100">
          {item.href === undefined ? (
            item.value
          ) : (
            <a
              class="underline underline-offset-4 hover:text-zinc-700 dark:hover:text-zinc-300"
              href={item.href}
            >
              {item.value}
            </a>
          )}
        </dd>
      </div>
    ))}
</dl>
