---
interface Props {
  class?: string;
  href: string;
  text: string;
}

const { class: className, href, text } = Astro.props;
---

<a
  class:list={[
    "rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm text-zinc-700 shadow-sm hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800",
    className,
  ]}
  href={href}
>
  {text}
</a>
