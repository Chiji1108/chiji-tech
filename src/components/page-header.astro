---
import PillLink from "@/components/pill-link.astro";

interface Props {
  lead: string;
  title: string;
}

const { lead, title } = Astro.props;
---

<header class="flex items-start justify-between gap-6">
  <div>
    <p class="text-sm text-zinc-500 dark:text-zinc-400">CHIJI TECH</p>
    <h1
      class="mt-2 font-semibold text-2xl text-zinc-900 tracking-tight dark:text-zinc-100"
    >
      {title}
    </h1>
    <p
      class="mt-3 text-pretty text-sm text-zinc-600 leading-relaxed dark:text-zinc-400"
    >
      {lead}
    </p>
  </div>

  <nav class="shrink-0"><PillLink href="/" text="トップへ" /></nav>
</header>
